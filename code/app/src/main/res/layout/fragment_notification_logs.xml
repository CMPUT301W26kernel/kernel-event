<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/primary_pale">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notification Logs"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/primary_deep"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/txt_empty_logs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No notification logs found."
        android:textColor="@color/grey_light"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_notification_logs"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>