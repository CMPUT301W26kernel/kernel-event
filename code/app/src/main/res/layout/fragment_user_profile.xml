<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E1F5F5"
    android:fillViewport="true"
    tools:context=".UserProfileFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp">

        <TextView
            android:id="@+id/profile_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Profile"
            android:textColor="#1A2F34"
            android:textSize="36sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/profile_role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="&lt;Role&gt;"
            android:textColor="#3F7E8A"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Delete Profile"
            android:textAllCaps="false"
            android:textSize="18sp"
            app:backgroundTint="#D9534F"
            app:cornerRadius="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_role" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sign_out_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign Out"
            android:textAllCaps="false"
            android:textSize="18sp"
            app:backgroundTint="#3F7E8A"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="@id/delete_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/delete_button" />

        <TextView
            android:id="@+id/username_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Edit Username"
            android:textColor="#1A2F34"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/delete_button" />

        <EditText
            android:id="@+id/profile_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:hint="Username123"
            android:inputType="text"
            android:padding="16dp"
            android:textColor="#1A2F34"
            app:layout_constraintTop_toBottomOf="@id/username_label" />

        <TextView
            android:id="@+id/email_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Edit Email"
            android:textColor="#1A2F34"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_username" />

        <EditText
            android:id="@+id/profile_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:hint="my.email@example.ca"
            android:inputType="textEmailAddress"
            android:padding="16dp"
            android:textColor="#1A2F34"
            app:layout_constraintTop_toBottomOf="@id/email_label" />

        <TextView
            android:id="@+id/phone_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Edit Phone Number"
            android:textColor="#1A2F34"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_email" />

        <EditText
            android:id="@+id/profile_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:hint="(XXX) XXX-XXXX"
            android:inputType="phone"
            android:padding="16dp"
            android:textColor="#1A2F34"
            app:layout_constraintTop_toBottomOf="@id/phone_label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/history_button"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:layout_marginTop="32dp"
            android:text="See Event History"
            android:textAllCaps="false"
            android:textSize="18sp"
            app:backgroundTint="#3F7E8A"
            app:cornerRadius="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_phone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notification_logs_button"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:layout_marginTop="16dp"
            android:text="See Notification Logs"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:visibility="gone"
            app:backgroundTint="#3F7E8A"
            app:cornerRadius="8dp"
            app:layout_goneMarginTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/history_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/entrant_list_button"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:layout_marginTop="16dp"
            android:text="See Entrant List"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:visibility="gone"
            app:backgroundTint="#3F7E8A"
            app:cornerRadius="8dp"
            app:layout_goneMarginTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/notification_logs_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pending_invites_button"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:layout_marginTop="16dp"
            android:text="@string/co_organizer_invites_button"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:visibility="gone"
            app:backgroundTint="#3F7E8A"
            app:cornerRadius="8dp"
            app:layout_goneMarginTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/entrant_list_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/done_button"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:layout_marginTop="16dp"
            android:text="Done"
            android:textAllCaps="false"
            android:textSize="18sp"
            app:backgroundTint="#3F7E8A"
            app:cornerRadius="8dp"
            app:layout_goneMarginTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pending_invites_button" />

        <TextView
            android:id="@+id/device_id_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:alpha="0.5"
            android:text="Device ID: Unknown"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/done_button" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>