<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_pale"
    tools:context=".EventOverviewFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header card with image as background -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/primary_deep">

            <ImageView
                android:id="@+id/image_event_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:alpha="0.4"
                android:contentDescription="Event poster" />

            <!-- A linear layout to hold Card buttons-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:layout_gravity="top">

                <Button
                    android:id="@+id/btn_back_to_events"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back"
                    android:contentDescription="@string/back_btn_desc"
                    android:backgroundTint="@color/primary_dark"
                    android:textColor="@color/primary_light"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_qr_generate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:visibility="gone"
                    android:contentDescription="@string/generate_qr_code"

                    android:backgroundTint="@color/primary_dark"

                    android:text="@string/generate_qr_code"
                    android:textColor="@color/primary_light"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:visibility="gone"
                    android:contentDescription=""

                    android:backgroundTint="@color/primary_dark"

                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="32dp"
                    app:iconTint="@color/primary_pale" />

            </LinearLayout>

            <!-- A Linear Layout to hold Card text-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_gravity="bottom">

                <TextView
                    android:id="@+id/text_event_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/default_event_title"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_event_organizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/primary_light"
                    android:textSize="13sp"
                    tools:text="Organizer: demo-organizer" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Details card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/text_event_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_dark"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"
                    tools:text="Registration: Apr 1 - Apr 9, 2026" />

                <TextView
                    android:id="@+id/text_event_waitlist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_dark"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"
                    tools:text="Waitlist entrants: 4" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/primary_light"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/text_event_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/default_event_description"
                    android:textColor="@color/primary_deep"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Action buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_join_waitlist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/primary_dark"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:padding="14dp"
            app:cornerRadius="12dp"
            android:text="@string/btn_join_leave_waitlist"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_manage_waitlist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/primary_deep"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:padding="14dp"
            app:cornerRadius="12dp"
            android:text="@string/btn_manage_waitlist"
            android:visibility="gone" />

        <!-- Comments card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/text_comments_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/comments_header"
                    android:textColor="@color/primary_deep"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/text_comment_permissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/grey_light"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Sign in to post a comment." />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_event_comments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_event_comment" />

                <TextView
                    android:id="@+id/text_comments_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:text="@string/comments_empty"
                    android:textColor="@color/grey_light"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/comment_composer_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/edit_comment_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="top|start"
                        android:hint="@string/comment_hint"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="4"
                        android:minHeight="48dp"
                        android:padding="12dp"
                        android:textColor="@color/primary_deep" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_post_comment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/primary_dark"
                        app:cornerRadius="10dp"
                        android:text="@string/comment_post_action" />

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>