<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_pale"
    tools:context=".MainActivity">

    <!-- This contains event attribute fields that users can modify -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:id="@+id/fillable_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="100dp">

            <!-- Edit Poster Image -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_margin="5dp"
                android:text="@string/prompt_image_edit"
                android:textSize="15sp"
                android:textColor="@color/primary_dark"/>

            <ImageView
                android:id="@+id/poster_image"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:src="@drawable/default_image"
                android:contentDescription="@string/poster_image_content_description" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clear_image_button"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginTop="5dp"
                android:visibility="gone"

                android:text="@string/clear_image"
                android:textSize="20sp"

                android:backgroundTint="@color/primary_mid"
                app:cornerRadius="12dp"/>

            <!-- Toggle for private events -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="30dp"
                android:layout_marginHorizontal="30dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="30dp"

                    android:text="@string/visibility"
                    android:textSize="20sp"
                    android:textColor="@color/primary_deep"/>

                <ToggleButton
                    android:id="@+id/visibility_toggle"
                    android:layout_width="110dp"
                    android:layout_height="50dp"
                    android:background="@drawable/toggle_background"

                    android:textOn="@string/visibility_private"
                    android:textOff="@string/visibility_public"
                    android:textColor="@color/toggle_text_colors"
                    android:textSize="18sp"/>

            </LinearLayout>

            <!-- Edit Event Title -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="5dp"

                android:text="@string/event_title"
                android:textSize="20sp"
                android:textColor="@color/primary_deep"/>

            <EditText
                android:id="@+id/edit_event_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:layout_marginHorizontal="30dp"

                android:inputType="text"
                android:importantForAutofill="no"
                android:text="@string/default_event_title"
                android:textSize="18sp"

                android:background="@color/white" />

            <!-- Edit Event Description -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="5dp"

                android:text="@string/event_description"
                android:textSize="20sp"
                android:textColor="@color/primary_deep"/>

            <EditText
                android:id="@+id/edit_event_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:layout_marginHorizontal="30dp"

                android:inputType="textMultiLine"
                android:importantForAutofill="no"
                android:text="@string/default_event_description"
                android:textSize="18sp"

                android:background="@color/white" />

            <!-- Edit Registration Open -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="5dp"

                android:text="@string/registration_open"
                android:textAlignment="center"
                android:textSize="20sp"
                android:textColor="@color/primary_deep"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/edit_reg_open_year"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:layout_marginHorizontal="10dp"

                    android:inputType="number"
                    android:importantForAutofill="no"
                    android:text=""
                    android:textSize="18sp"
                    android:maxLength="4"

                    android:background="@color/white" />

                <EditText
                    android:id="@+id/edit_reg_open_month"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:layout_marginHorizontal="10dp"

                    android:inputType="number"
                    android:importantForAutofill="no"
                    android:text=""
                    android:textSize="18sp"
                    android:maxLength="2"

                    android:background="@color/white" />

                <EditText
                    android:id="@+id/edit_reg_open_day"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:layout_marginHorizontal="10dp"

                    android:inputType="number"
                    android:importantForAutofill="no"
                    android:text=""
                    android:textSize="18sp"
                    android:maxLength="2"

                    android:background="@color/white" />

            </LinearLayout>


            <!-- Edit Registration Close -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="5dp"

                android:text="@string/registration_close"
                android:textAlignment="center"
                android:textSize="20sp"
                android:textColor="@color/primary_deep"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/edit_reg_close_year"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:layout_marginHorizontal="10dp"

                    android:inputType="number"
                    android:importantForAutofill="no"
                    android:text=""
                    android:textSize="18sp"
                    android:maxLength="4"

                    android:background="@color/white" />

                <EditText
                    android:id="@+id/edit_reg_close_month"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:layout_marginHorizontal="10dp"

                    android:inputType="number"
                    android:importantForAutofill="no"
                    android:text=""
                    android:textSize="18sp"
                    android:maxLength="2"

                    android:background="@color/white" />

                <EditText
                    android:id="@+id/edit_reg_close_day"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:layout_marginHorizontal="10dp"

                    android:inputType="number"
                    android:importantForAutofill="no"
                    android:text=""
                    android:textSize="18sp"
                    android:maxLength="2"

                    android:background="@color/white" />

            </LinearLayout>

            <!-- Venue: street address only (coordinates are derived automatically) -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="5dp"
                android:text="@string/venue_location"
                android:textColor="@color/primary_deep"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/edit_venue_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:background="@color/white"
                android:hint="@string/venue_address_hint"
                android:importantForAutofill="no"
                android:inputType="textPostalAddress"
                android:padding="10dp"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="4dp"
                android:text="@string/venue_address_no_coordinates_note"
                android:textColor="@color/grey_light"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/checkbox_require_geolocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="26dp"
                android:layout_marginTop="12dp"
                android:text="@string/require_geolocation_waitlist"
                android:textColor="@color/primary_deep"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/edit_geolocation_radius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="8dp"
                android:background="@color/white"
                android:hint="@string/geolocation_radius_hint"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="4dp"
                android:text="@string/geo_verification_radius_note"
                android:textColor="@color/grey_light"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="5dp"
                android:text="@string/event_tags_hint"
                android:textColor="@color/primary_deep"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/edit_event_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:background="@color/white"
                android:importantForAutofill="no"
                android:inputType="text"
                android:padding="10dp"
                android:textSize="18sp" />

            <!-- Edit Waiting List Capacity -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="5dp"

                android:text="@string/waiting_list_capacity"
                android:textSize="20sp"
                android:textColor="@color/primary_deep"/>

            <EditText
                android:id="@+id/edit_capacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:layout_marginHorizontal="30dp"

                android:inputType="number"
                android:importantForAutofill="no"
                android:text=""
                android:textSize="18sp"

                android:background="@color/white" />

        </LinearLayout>

    </ScrollView>

    <!-- This contains the confirmation and cancellation buttons-->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="5dp"
        android:gravity="center"
        android:background="@color/primary_mid"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_button"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"

            android:text="@string/cancel"
            android:textSize="20sp"

            android:backgroundTint="@color/primary_dark"
            app:cornerRadius="12dp"/>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirm_button"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:layout_marginStart="10dp"

            android:text="@string/confirm"
            android:textSize="20sp"

            android:backgroundTint="@color/primary_dark"
            app:cornerRadius="12dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>