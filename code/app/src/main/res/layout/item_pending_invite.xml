<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="#FFFFFF"
    android:layout_marginBottom="8dp"
    android:elevation="2dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/invite_event_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/invite_for_event"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/invite_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="From: Loading..."
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/invite_role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Role: Co-Organizer"
            android:textColor="#666666"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <Button
            android:id="@+id/btn_accept_invite"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/accept_invite"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btn_decline_invite"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/decline_invite"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#D9534F" />
    </LinearLayout>
</LinearLayout>