<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/primary_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txt_log_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Message"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/primary_deep" />

        <TextView
            android:id="@+id/txt_log_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="TYPE"
            android:textColor="@color/primary_dark"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_log_sender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Sender: " />

        <TextView
            android:id="@+id/txt_log_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event ID: " />

        <TextView
            android:id="@+id/txt_log_recipients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipients: 0" />

        <TextView
            android:id="@+id/txt_log_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Time"
            android:textColor="@color/grey_light"
            android:textSize="12sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>